# ===== LLM（必填）=====
IBEX_API_KEY=sk-xxx
# OpenAI 兼容接口，默认阿里千问
IBEX_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IBEX_MODEL_NAME=qwen-max

# ===== 持久化底座 =====
IBEX_DATABASE_URL=postgresql://ibex:ibex@localhost:5432/ibex
IBEX_REDIS_URL=redis://localhost:6379/0
# 生产 compose 里 postgres 容器用的密码
IBEX_PG_PASSWORD=ibex

# ===== 网关多租户（JSON：api key -> tenant）=====
IBEX_API_KEYS={}
# python -m scripts.prepare_deploy creates a local owner key if the mapping is empty.

# ===== 沙箱 =====
# provider: docker（自托管）/ daytona（外部托管）/ none（本地退化，无沙箱；服务路径走本地文件后端）
IBEX_SANDBOX_PROVIDER=docker
# runtime: runc（加固容器）/ runsc（gVisor）/ kata（microVM）
IBEX_SANDBOX_RUNTIME=runc

# ===== 飞书（可选，用飞书渠道才填）=====
IBEX_FEISHU_APP_ID=
IBEX_FEISHU_APP_SECRET=

# ===== LangSmith（可选）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ===== Fixed integration settings =====
# Build first: docker build -t ibex-sandbox:local -f sandbox/Dockerfile .
IBEX_SANDBOX_IMAGE=ibex-sandbox:local
# Required by production compose; generate a random secret, never commit it.
IBEX_SANDBOX_API_TOKEN=
# Local process: leave empty. Compose overrides this to http://sandbox:8003.
IBEX_SANDBOX_API_URL=
IBEX_AGENT_TEAM=false
IBEX_TASK_MAX_TRIES=3
IBEX_TASK_RETRY_DELAY=2
IBEX_TASK_TIMEOUT=600
IBEX_SEARCH_ENDPOINT=https://www.bing.com/search
IBEX_SEARCH_MAX_BYTES=1000000

# Deployment ports / metrics (prepare_deploy generates missing secrets)
IBEX_HTTP_PORT=18704
IBEX_PROMETHEUS_PORT=18705
IBEX_GRAFANA_PORT=18706
IBEX_METRICS_TOKEN=
IBEX_GRAFANA_PASSWORD=
IBEX_WORKSPACE_MAX_FILES=500
IBEX_WORKSPACE_MAX_BYTES=8000000
IBEX_DELIVERY_MAX_ATTEMPTS=6
IBEX_DELIVERY_RETRY_DELAY=5
IBEX_FEISHU_TENANT_ID=feishu
IBEX_FEISHU_VERIFICATION_TOKEN=
IBEX_FEISHU_ENCRYPT_KEY=
IBEX_DAYTONA_SNAPSHOT=
IBEX_DAYTONA_PREPARE_DEPENDENCIES=true
