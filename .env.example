# ===== LLM（必填）=====
IBEX_API_KEY=sk-xxx
# OpenAI 兼容接口，默认阿里千问
IBEX_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IBEX_MODEL_NAME=qwen-max

# ===== 持久化底座 =====
IBEX_DATABASE_URL=postgresql://ibex:ibex@localhost:5432/ibex
IBEX_REDIS_URL=redis://localhost:6379/0
# 生产 compose 里 postgres 容器用的密码
IBEX_PG_PASSWORD=ibex

# ===== 网关多租户（JSON：api key -> tenant）=====
IBEX_API_KEYS={"key-tenant-a":"tenant-a","key-tenant-b":"tenant-b"}

# ===== 沙箱 =====
# provider: docker（自托管）/ daytona（外部托管）
IBEX_SANDBOX_PROVIDER=docker
# runtime: runc（加固容器）/ runsc（gVisor）/ kata（microVM）
IBEX_SANDBOX_RUNTIME=runc

# ===== 飞书（可选，用飞书渠道才填）=====
IBEX_FEISHU_APP_ID=
IBEX_FEISHU_APP_SECRET=

# ===== LangSmith（可选）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
