{"uid": "ibex-overview", "title": "Ibex service overview", "schemaVersion": 39, "version": 1, "refresh": "5s", "panels": [{"id": 1, "title": "HTTP requests / second", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(http_requests_total[5m]))", "refId": "A"}]}, {"id": 2, "title": "HTTP errors / second", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}]}, {"id": 3, "title": "Active sandboxes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(sandbox_active)", "refId": "A"}]}, {"id": 4, "title": "Model fallback attempts", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(agent_fallback_total)", "refId": "A"}]}, {"id": 5, "title": "Queue length", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "sum(agent_queue_length)", "refId": "A"}]}, {"id": 6, "title": "Delivery states", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "ibex-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "sum by (status) (ibex_delivery_records)", "refId": "A"}]}]}